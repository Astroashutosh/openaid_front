# ==============================================================================
# GLOBAL FRONTEND ENVIRONMENT CONFIGURATION (ADMIN & USER)
# ==============================================================================
# Changing VITE_API_BASE_URL here globally changes the API endpoint across the
# ENTIRE frontend for both Admin and User portals.
#
# Options:
# 1. Local Development (default):
#    VITE_API_BASE_URL=http://localhost:5000/api
#
# 2. Production (openaidinternational.com):
#    VITE_API_BASE_URL=https://www.openaidinternational.com/api
# ==============================================================================
VITE_API_BASE_URL=http://localhost:5000/api
